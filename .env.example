# Generate random values locally. Never commit a populated .env.
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MCP_CLIENT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_URL=http://127.0.0.1:8081
MCP_REDIRECT_URIS=http://127.0.0.1:45838/callback
# Public ChatGPT plugin deployment (use a stable HTTPS origin and an HTTPS reverse proxy).
# PUBLIC_CHATGPT_PLUGIN=true
# MCP_CLIENT_ID=habit-tracker-chatgpt
# MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# OPENAI_APPS_CHALLENGE=
# BACKEND_BIND=127.0.0.1
# Optional social login; keep real values only in .local/social.env.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VK_CLIENT_ID=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
